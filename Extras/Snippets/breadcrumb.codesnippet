<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>IDECodeSnippetCompletionPrefix</key>
    <string>smlcrumb</string>
    <key>IDECodeSnippetCompletionScopes</key>
    <array><string>All</string></array>
    <key>IDECodeSnippetContents</key>
    <string>SwiftMoLogger.breadcrumb("&lt;#what happened#&gt;", category: .&lt;#userAction#&gt;)</string>
    <key>IDECodeSnippetIdentifier</key>
    <string>com.swiftmologger.breadcrumb</string>
    <key>IDECodeSnippetLanguage</key>
    <string>Xcode.SourceCodeLanguage.Swift</string>
    <key>IDECodeSnippetSummary</key>
    <string>Record a breadcrumb for crash-bundle attachment.</string>
    <key>IDECodeSnippetTitle</key>
    <string>SwiftMoLogger breadcrumb</string>
    <key>IDECodeSnippetUserSnippet</key>
    <true/>
    <key>IDECodeSnippetVersion</key>
    <integer>2</integer>
</dict>
</plist>
