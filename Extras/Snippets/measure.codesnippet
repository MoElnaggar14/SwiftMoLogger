<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>IDECodeSnippetCompletionPrefix</key>
    <string>smlmeasure</string>
    <key>IDECodeSnippetCompletionScopes</key>
    <array><string>All</string></array>
    <key>IDECodeSnippetContents</key>
    <string>LogSignpost.measure("&lt;#name#&gt;", tag: .performance) {
    &lt;#code#&gt;
}</string>
    <key>IDECodeSnippetIdentifier</key>
    <string>com.swiftmologger.measure</string>
    <key>IDECodeSnippetLanguage</key>
    <string>Xcode.SourceCodeLanguage.Swift</string>
    <key>IDECodeSnippetSummary</key>
    <string>Wrap a code block in a signpost interval with auto-logged elapsed_ms.</string>
    <key>IDECodeSnippetTitle</key>
    <string>SwiftMoLogger measure</string>
    <key>IDECodeSnippetUserSnippet</key>
    <true/>
    <key>IDECodeSnippetVersion</key>
    <integer>2</integer>
</dict>
</plist>
