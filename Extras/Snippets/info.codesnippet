<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>IDECodeSnippetCompletionPrefix</key>
    <string>smlinfo</string>
    <key>IDECodeSnippetCompletionScopes</key>
    <array><string>All</string></array>
    <key>IDECodeSnippetContents</key>
    <string>SwiftMoLogger.info("&lt;#message#&gt;", tag: .&lt;#tag#&gt;, metadata: ["&lt;#key#&gt;": .string("&lt;#value#&gt;")])</string>
    <key>IDECodeSnippetIdentifier</key>
    <string>com.swiftmologger.info</string>
    <key>IDECodeSnippetLanguage</key>
    <string>Xcode.SourceCodeLanguage.Swift</string>
    <key>IDECodeSnippetSummary</key>
    <string>Structured info log entry with tag and metadata.</string>
    <key>IDECodeSnippetTitle</key>
    <string>SwiftMoLogger info</string>
    <key>IDECodeSnippetUserSnippet</key>
    <true/>
    <key>IDECodeSnippetVersion</key>
    <integer>2</integer>
</dict>
</plist>
